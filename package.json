{
  "name": "astroguruai",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @astro/api dev",
    "dev:worker": "pnpm --filter @astro/worker dev",
    "dev:web": "pnpm --filter @astro/web dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @astro/api prisma:generate",
    "db:migrate": "pnpm --filter @astro/api prisma:migrate",
    "db:seed": "pnpm --filter @astro/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "redis-memory-server": "^0.17.0",
    "typescript": "^5.8.3"
  }
}
