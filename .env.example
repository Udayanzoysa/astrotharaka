# Web (Next.js) — set at build time for production deploys
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Local only: enables PayHere sandbox-complete after return (never true in production)
NEXT_PUBLIC_ALLOW_DEV_PAYMENTS=false

# Application — set NODE_ENV=production for go-live
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
# Production: set to your real web origin(s), comma-separated if needed
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://astro:astro@localhost:5432/astroguruai?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth — use long random secrets in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
# Google OAuth (optional — buttons redirect with error if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Facebook Login (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# Astrology engine (Swiss Ephemeris required for go-live)
ASTROLOGY_ENGINE_URL=http://localhost:8001
# Never set true in production
ALLOW_PLACEHOLDER_CHART=false

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_REPORTS=astro-reports
S3_FORCE_PATH_STYLE=true

# Payments — production: PAYHERE_MODE=live + real merchant credentials
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=LKR
PAYHERE_MODE=sandbox
PAYHERE_NOTIFY_URL=http://localhost:3000/api/v1/webhooks/payhere
PAYHERE_RETURN_URL=http://localhost:3001/orders
PAYHERE_CANCEL_URL=http://localhost:3001/orders
# Local only: ALLOW_DEV_PAYMENTS=true enables DEV_CONFIRM + customer self-confirm (blocked in production)
ALLOW_DEV_PAYMENTS=false

REPORTS_DIR=./uploads/reports
# PDF: auto (Chromium then PDFKit fallback) | chromium | pdfkit
PDF_ENGINE=auto
# PDF_FONT_PATH=C:\Windows\Fonts\Nirmala.ttc
OTP_TTL_MINUTES=15
# Never true in production (OTPs must only go via email/SMS)
OTP_RETURN_IN_RESPONSE=false
NOTIFICATIONS_DIR=./uploads/notifications
WEB_APP_URL=http://localhost:3001

# Email / SMTP — Namecheap Private Email defaults (also Admin → Settings)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yourdomain.com
SMTP_PASS=
SMTP_FROM=Taraka <info@yourdomain.com>
# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
BANK_NAME=Commercial Bank of Ceylon
BANK_ACCOUNT_NAME=Taraka AstroAI Lanka
BANK_ACCOUNT_NUMBER=8001234567
BANK_BRANCH=Colombo

# AI narrative — production requires a real key (local fallback disabled in production)
OPENAI_API_KEY=
GEMINI_API_KEY=
NARRATIVE_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
