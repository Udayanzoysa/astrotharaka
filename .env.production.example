# ============================================================
# Taraka / AstroGuruAI — PRODUCTION env for astrotharaka.com
# Copy to .env.production on the server and fill every secret.
# NEVER commit .env.production
# ============================================================

# --- Domains ---
WEB_APP_URL=https://astrotharaka.com
CORS_ORIGIN=https://astrotharaka.com
NEXT_PUBLIC_API_URL=https://api.astrotharaka.com/api/v1
NEXT_PUBLIC_ALLOW_DEV_PAYMENTS=false

# --- App ---
NODE_ENV=production
API_PREFIX=api/v1
OTP_TTL_MINUTES=15
OTP_RETURN_IN_RESPONSE=false
ALLOW_DEV_PAYMENTS=false
ALLOW_PLACEHOLDER_CHART=false
PDF_ENGINE=pdfkit

# --- Auth (generate: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# --- Postgres (docker compose) ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_DB=astroguruai

# --- Redis ---
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD

# --- MinIO / S3 ---
S3_ACCESS_KEY_ID=REPLACE_MINIO_USER
S3_SECRET_ACCESS_KEY=REPLACE_MINIO_PASSWORD_MIN_8
S3_BUCKET_REPORTS=astro-reports
S3_REGION=us-east-1

# --- PayHere LIVE ---
PAYHERE_MODE=live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=LKR
PAYHERE_NOTIFY_URL=https://api.astrotharaka.com/api/v1/webhooks/payhere
PAYHERE_RETURN_URL=https://astrotharaka.com/orders
PAYHERE_CANCEL_URL=https://astrotharaka.com/orders

# --- SMTP (Namecheap Private Email) ---
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@astrotharaka.com
SMTP_PASS=
SMTP_FROM=Taraka <info@astrotharaka.com>

# --- AI ---
GEMINI_API_KEY=
OPENAI_API_KEY=
NARRATIVE_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.astrotharaka.com/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.astrotharaka.com/api/v1/auth/facebook/callback

# --- WhatsApp (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- SSL bootstrap ---
SSL_EMAIL=admin@astrotharaka.com

# --- Bank display defaults (also editable in Admin) ---
BANK_NAME=Commercial Bank of Ceylon
BANK_ACCOUNT_NAME=Taraka AstroAI Lanka
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=Colombo
