generator client {
  provider      = "prisma-client-js"
  // native = local Windows/Mac; debian-openssl-3.0.x = Docker node:20-bookworm
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPPORT
  FINANCE
  CONTENT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum LanguageCode {
  en
  si
  ta
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  PAID
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  CONFIRMED
  FAILED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  PAYHERE
  BANK_TRANSFER
  DEV_CONFIRM
}

enum ReportStatus {
  QUEUED
  CALCULATING
  GENERATING_CONTENT
  RENDERING_PDF
  READY
  FAILED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  /// Null for OAuth-only accounts (Google / Facebook).
  passwordHash       String?
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  blockedAt          DateTime?
  /// One-time freemium teaser already consumed (registered users).
  hasUsedFreePreview Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile         CustomerProfile?
  birthProfiles   BirthProfile[]
  orders          Order[]
  challenges      AuthChallenge[]
  oauthAccounts   OAuthAccount[]
  subscriptions   UserSubscription[]
  subscriptionCheckouts SubscriptionCheckout[]
  freePreviewLogs FreePreviewLog[]
  guestReports    GuestReport[]
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum AuthChallengePurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthChallenge {
  id         String               @id @default(uuid())
  userId     String?
  email      String
  purpose    AuthChallengePurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                  @default(0)
  createdAt  DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
}

model CustomerProfile {
  id                       String       @id @default(uuid())
  userId                   String       @unique
  fullName                 String
  mobileNumber             String?
  whatsappNumber           String?
  preferredLanguage        LanguageCode @default(en)
  country                  String       @default("LK")
  birthDate                DateTime?    @db.Date
  birthTime                DateTime?    @db.Time(0)
  unknownBirthTime         Boolean      @default(false)
  birthPlaceName           String?
  /// female | male | other
  gender                   String?
  emailMarketingConsent    Boolean      @default(false)
  whatsappMarketingConsent Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BirthProfile {
  id                String       @id @default(uuid())
  userId            String
  fullName          String
  birthDate         DateTime     @db.Date
  birthTime         DateTime?    @db.Time(0)
  unknownBirthTime  Boolean      @default(false)
  birthPlaceName    String
  latitude          Float?
  longitude         Float?
  timezone          String       @default("Asia/Colombo")
  preferredLanguage LanguageCode @default(en)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

enum DiscountType {
  PERCENT
  FIXED
}

model Product {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  nameEn               String
  nameSi               String?
  nameTa               String?
  descriptionEn        String
  descriptionSi        String?
  descriptionTa        String?
  estimatedMinutes     Int      @default(15)
  supportedLanguages   LanguageCode[]
  samplePreviewUrl     String?
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  prices     ProductPrice[]
  orders     Order[]
  promotions Promotion[]     @relation("PromotionProducts")
}

model ProductPrice {
  id        String   @id @default(uuid())
  productId String
  currency  String   @default("LKR")
  amount    Decimal  @db.Decimal(12, 2)
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isCurrent])
}

model Order {
  id                 String       @id @default(uuid())
  orderNumber        String       @unique
  userId             String
  productId          String
  birthProfileId     String
  promotionId        String?
  promoCode          String?
  language           LanguageCode @default(en)
  status             OrderStatus  @default(AWAITING_PAYMENT)
  currency           String       @default("LKR")
  productPriceAmount Decimal      @db.Decimal(12, 2)
  discountAmount     Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal      @db.Decimal(12, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  paidAt             DateTime?
  completedAt        DateTime?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id])
  birthProfile BirthProfile         @relation(fields: [birthProfileId], references: [id])
  promotion    Promotion?           @relation(fields: [promotionId], references: [id])
  payments     Payment[]
  reports      GeneratedReport[]
  redemption   PromotionRedemption?

  @@index([userId])
  @@index([status])
}

model Promotion {
  id               String       @id @default(uuid())
  code             String       @unique
  name             String
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(12, 2)
  minOrderAmount   Decimal?     @db.Decimal(12, 2)
  maxRedemptions   Int?
  perCustomerLimit Int          @default(1)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products     Product[]             @relation("PromotionProducts")
  orders       Order[]
  redemptions  PromotionRedemption[]
}

model PromotionRedemption {
  id          String   @id @default(uuid())
  promotionId String
  userId      String
  orderId     String   @unique
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promotionId, userId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("LKR")
  /// PayHere payment id, or customer bank transfer reference number
  providerRef       String?
  bankSlipUrl       String?
  bankAccountId     String?
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  confirmedAt       DateTime?

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([providerRef])
  @@index([bankAccountId])
}

/// Admin-managed bank accounts shown on bank-transfer checkout.
model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountHolder String
  accountNumber String
  branch        String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments Payment[]
  subscriptionPayments SubscriptionPayment[]

  @@index([isActive, sortOrder])
}

model GeneratedReport {
  id             String       @id @default(uuid())
  orderId        String
  version        Int          @default(1)
  status         ReportStatus @default(QUEUED)
  language       LanguageCode
  title          String?
  contentText    String?
  pdfStorageKey  String?
  downloadUrl    String?
  engineVersion  String?
  aiModel        String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  readyAt        DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@index([orderId])
}

/// Instant free guest PDF — no user account required.
model GuestReport {
  id               String       @id @default(uuid())
  downloadToken    String       @unique
  userId           String?
  /// True when this report was generated via the one-time freemium teaser.
  isFreePreview    Boolean      @default(true)
  /// When true, API returns full unlocked sections (active subscription).
  fullUnlocked     Boolean      @default(false)
  fullName         String
  gender           String
  email            String
  mobile           String?
  birthDate        DateTime     @db.Date
  birthTime        DateTime?    @db.Time(0)
  unknownBirthTime Boolean      @default(false)
  birthPlaceName   String
  latitude         Float?
  longitude        Float?
  timezone         String       @default("Asia/Colombo")
  language         LanguageCode @default(si)
  status           ReportStatus @default(QUEUED)
  title            String?
  contentText      String?
  pdfStorageKey    String?
  engineVersion    String?
  aiModel          String?
  errorMessage     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  readyAt          DateTime?
  expiresAt        DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([userId])
}

enum FreePreviewService {
  HOROSCOPE
  BABY_NAMES
  PORONDAM
}

/// Server-side one-time free preview tracking (guest cookie/IP and/or user).
model FreePreviewLog {
  id        String             @id @default(uuid())
  userId    String?
  guestKey  String?
  ipHash    String?
  service   FreePreviewService
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guestKey])
  @@index([ipHash])
  @@index([userId])
  @@index([createdAt])
}

/// AI baby name suggestions — public, no account required.
model BabyNameRequest {
  id                   String   @id @default(uuid())
  publicToken          String   @unique
  birthDate            DateTime @db.Date
  birthTime            DateTime? @db.Time(0)
  birthPlaceName       String
  latitude             Float?
  longitude            Float?
  timezone             String   @default("Asia/Colombo")
  firstLetter          String
  secondLetter         String
  gender               String?
  /// Selected style preferences: Modern, SouthIndian, Unique, Traditional
  stylesJson           Json?
  /// JSON array: [{ "name": "...", "meaning": "...", "style_tag": "Modern" }, ...]
  namesJson            Json?
  aiModel              String?
  errorMessage         String?
  status               String   @default("READY")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdAt])
  @@index([publicToken])
}

/// Marriage Porondam compatibility — public, no account required.
model PorondamMatch {
  id              String   @id @default(uuid())
  publicToken     String   @unique
  groomName       String
  groomBirthDate  DateTime @db.Date
  groomBirthTime  DateTime @db.Time(0)
  groomPlaceName  String
  groomLatitude   Float?
  groomLongitude  Float?
  brideName       String
  brideBirthDate  DateTime @db.Date
  brideBirthTime  DateTime @db.Time(0)
  bridePlaceName  String
  brideLatitude   Float?
  brideLongitude  Float?
  timezone        String   @default("Asia/Colombo")
  /// Calculated anchors for both partners (nakshatra, pada, rashi, lagna, mars…)
  anchorsJson     Json?
  /// Full AI report: score, porondam_details, dosha_analysis, summary_si
  reportJson      Json?
  compatibilityScore String?
  aiModel         String?
  errorMessage    String?
  status          String   @default("READY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([publicToken])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionCheckoutStatus {
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  PAID
  ACTIVATED
  CANCELLED
}

enum QuotaService {
  BABY_NAMES
  PORONDAM
  HOROSCOPE
}

/// Monthly subscription package (admin-editable). Quota changes apply to future subs only.
model SubscriptionPackage {
  id              String   @id @default(uuid())
  code            String   @unique
  nameEn          String
  nameSi          String?
  nameTa          String?
  descriptionEn   String?
  descriptionSi   String?
  descriptionTa   String?
  /// Monthly price in LKR (admin-editable)
  priceLkr        Decimal  @db.Decimal(12, 2)
  babyNamesQuota  Int      @default(3)
  porondamQuota   Int      @default(2)
  horoscopeQuota  Int      @default(2)
  /// Billing period length in days (default 30)
  durationDays    Int      @default(30)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions UserSubscription[]
  checkouts     SubscriptionCheckout[]

  @@index([isActive, sortOrder])
}

/// Pending subscription purchase before payment confirmation.
model SubscriptionCheckout {
  id                 String                     @id @default(uuid())
  checkoutNumber     String                     @unique
  userId             String
  packageId          String
  packageCode        String
  packageNameEn      String
  priceLkr           Decimal                    @db.Decimal(12, 2)
  currency           String                     @default("LKR")
  status             SubscriptionCheckoutStatus @default(AWAITING_PAYMENT)
  userSubscriptionId String?                    @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  paidAt             DateTime?
  activatedAt        DateTime?

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package      SubscriptionPackage     @relation(fields: [packageId], references: [id])
  payments     SubscriptionPayment[]
  subscription UserSubscription?       @relation(fields: [userSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
}

/// Payment attempt for a subscription checkout (PayHere or bank transfer).
model SubscriptionPayment {
  id             String        @id @default(uuid())
  checkoutId     String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("LKR")
  providerRef    String?
  bankSlipUrl    String?
  bankAccountId  String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  confirmedAt    DateTime?

  checkout    SubscriptionCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([checkoutId])
  @@index([providerRef])
}

/// Active/historical user subscription. Quotas are snapshotted at purchase so package edits stay safe.
model UserSubscription {
  id                   String             @id @default(uuid())
  userId               String
  packageId            String
  /// Snapshots of package at purchase time
  packageCode          String
  packageNameEn        String
  packageNameSi        String?
  priceLkr             Decimal            @db.Decimal(12, 2)
  babyNamesQuota       Int
  porondamQuota        Int
  horoscopeQuota       Int
  durationDays         Int                @default(30)
  startAt              DateTime           @default(now())
  expiresAt            DateTime
  status               SubscriptionStatus @default(ACTIVE)
  /// Payment reference / method note (e.g. DEV_CONFIRM, BANK, PAYHERE)
  paymentRef           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package SubscriptionPackage  @relation(fields: [packageId], references: [id])
  usage   SubscriptionUsage?
  checkout SubscriptionCheckout?

  @@index([userId, status])
  @@index([expiresAt])
  @@index([packageId])
}

/// Per-subscription usage counters for the 30-day cycle.
model SubscriptionUsage {
  id               String   @id @default(uuid())
  userId           String
  subscriptionId   String   @unique
  babyNamesUsed    Int      @default(0)
  porondamUsed     Int      @default(0)
  horoscopeUsed    Int      @default(0)
  /// Cycle label e.g. 2026-07-23_2026-08-22
  monthCycle       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Key/value app settings (SMTP, etc.).
model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}
